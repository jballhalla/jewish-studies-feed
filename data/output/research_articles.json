      "articles": [
        {
          "doi": "10.1093/hgs/dcag049",
          "title": "The art of listening and the digital turn: Fortunoff Video Archive's testimony-centered teaching initiatives",
          "authors": "Marczyk, Agnieszka Aya",
          "journal_name": "Holocaust and Genocide Studies",
          "journal_abbrev": "Holo Geno Stud",
          "issn": "8756-6583",
          "volume": null,
          "issue": null,
          "pages": null,
          "abstract": "Abstract This article discusses the Fortunoff Video Archive's ongoing efforts to build testimony-centered online digital learning materials for secondary schools. Because of its witness-centered interview methodology and its origins as a project created by the New Haven survivor community, the archive is particularly well positioned to help students explore the nature and mediated character of Holocaust testimony. The archive's digital learning initiatives therefore ask students to explore testimony as both a complex historical source and a representation of memory, and to apply this understanding to the act of listening to victims of mass violence. Situating the archive's approach to teaching with digital testimony in the broader landscape of Holocaust education, this article explores examples of how Fortunoff learning materials engage students in empathetic listening and historical analysis, and prompt them to explore the role of archives in collecting, co-constructing, and disseminating Holocaust testimonies.",
          "url": "https://doi.org/10.1093/hgs/dcag049",
          "published_online": "2026-10-28T00:00:00",
          "published_print": null,
          "published_date": "2026-10-28T00:00:00",
          "subjects": null,
          "article_type": "journal-article"
        }
